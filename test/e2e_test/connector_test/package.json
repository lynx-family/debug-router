{
  "name": "connector_test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:without-device",
    "test:without-device": "npm run test:multiplexer:without-device",
    "test:legacy:without-device": "node debug_router_connector_auto_test.js --mode no-device",
    "test:multiplexer:without-device": "node multiplexer/no_device.js && node multiplexer/websocket_routing.js && node multiplexer/wifi_runtime.js",
    "test:multiplexer:wifi-runtime": "node multiplexer/wifi_runtime.js",
    "test:with-device": "npm run test:multiplexer:with-device",
    "test:multiplexer:with-device": "node multiplexer/real_device.js --platform all",
    "test:multiplexer:with-device:android": "node multiplexer/real_device.js --platform android",
    "test:multiplexer:with-device:android:usb-notification": "node multiplexer/real_device.js --platform android --require-message-roundtrip --no-recovery --no-legacy-preemption --no-websocket",
    "test:multiplexer:with-device:ios": "node multiplexer/real_device.js --platform ios",
    "test:multiplexer:with-device:wifi:android": "node multiplexer/real_device_wifi.js",
    "test:multiplexer:stress": "node multiplexer/real_device_stress.js --platform all",
    "test:multiplexer:stress:android": "node multiplexer/real_device_stress.js --platform android",
    "test:multiplexer:stress:wifi:android": "node multiplexer/real_device_stress.js --platform android --transport wifi",
    "test:multiplexer:stress:wifi:android:smoke": "node multiplexer/real_device_stress.js --platform android --transport wifi --duration-ms 30000 --connectors 2 --frontends 2 --concurrency 4 --message-count 20 --rounds 2 --no-recovery --no-legacy-preemption",
    "test:multiplexer:stress:ios": "node multiplexer/real_device_stress.js --platform ios",
    "test:legacy:with-device": "node debug_router_connector_auto_test.js --mode real-device --platform all",
    "test:legacy:with-device:android": "node debug_router_connector_auto_test.js --mode real-device --platform android",
    "test:legacy:with-device:ios": "node debug_router_connector_auto_test.js --mode real-device --platform ios --no-launch-app",
    "test:with-device:harmony": "node debug_router_connector_auto_test.js --mode real-device --platform harmony --no-launch-app"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@lynx-js/debug-router-connector": "file:../../../debug_router_connector",
    "ws": "^8.12.1"
  }
}
